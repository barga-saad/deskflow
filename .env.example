# Copy to .env to override the local defaults in docker-compose.yml.
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
SEED_DEMO_DATA=true

# AI triage. Any OpenAI-compatible server works. Leave disabled to use the keyword rules.
AI_ENABLED=false
AI_BASE_URL=http://ollama:11434/v1
AI_MODEL=llama3.2
AI_API_KEY=
